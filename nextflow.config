params {
    fastqc = '/absolute/path/to/FastQC/fastqc'
    manifest = null
    stage = 'full'
    approvals = "${projectDir}/approved_raw_adapter_runs.txt"
    trim_overrides = "${projectDir}/trim_overrides.tsv"
    combined_adapters = "${projectDir}/provenance/adapters_combined.fa"
    adapters = '/absolute/path/to/Trimmomatic-0.39/adapters/TruSeq3-PE.fa'
    trimmomatic_jar = '/absolute/path/to/trimmomatic-0.39.jar'
    picard_jar = '/absolute/path/to/picard.jar'
    reference = null
    account = null
    partition = 'medium'
    quality_options = 'AVGQUAL:20 MINLEN:50'
    outdir = "${launchDir}/results"
}
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    time = '72h'
    errorStrategy = 'terminate'
    withName: 'FASTQC_RAW|FASTQC_TRIM' {
        beforeScript = 'module purge; module load Java/21.0.8'
    }
    withName: NORMALIZE_LB {
        beforeScript = 'module purge'
    }
    withName: TRIM {
        beforeScript = 'module purge; module load Java/21.0.8'
    }
    withName: MAP {
        beforeScript = '''
            module purge
            module load GCC/14.3.0 BCFtools/1.22 SAMtools/1.22.1 Java/21.0.8
            export PILOT_SAMTOOLS=$(command -v samtools)
            module load site/langs Anaconda3/2025.12-1
            CONDA_BASE=$(conda info --base)
            set +u
            source "${CONDA_BASE}/etc/profile.d/conda.sh"
            conda activate /absolute/path/to/bwa_env
            set -u
            export PILOT_BWA=$(command -v bwa)
        '''
    }
    withName: DEDUP {
        beforeScript = 'module purge; module load GCC/14.3.0 Java/21.0.8 SAMtools/1.22.1'
    }
    withName: 'BAM_STATS|MERGE_RUNS' {
        beforeScript = 'module purge; module load GCC/14.3.0 SAMtools/1.22.1'
    }
}
profiles {
    slurm {
        process.executor = 'slurm'
        process.queue = params.partition
        process.clusterOptions = "--account=${params.account}"
        executor.queueSize = 15
    }
}
trace.enabled = true
report.enabled = true
timeline.enabled = true
